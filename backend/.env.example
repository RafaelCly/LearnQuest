# Selecciona el proveedor de IA activo: "azure" | "openai" | "gemini"
LLM_PROVIDER=azure

# --- Azure AI Foundry (mientras dure el free trial) ---
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# --- OpenAI (fallback post free-trial, presupuesto ajustado) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Base de datos (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
